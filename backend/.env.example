# Server Configurations
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# AI LLM API Keys (Google Gemini API / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Web Search API Key (Serper API - https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Vector DB & Storage Configurations
CHROMA_PERSIST_DIR=vectorstore
RAW_PDFS_DIR=data/raw_pdfs
PROCESSED_DATA_DIR=data/processed

# RAG & Routing Configurations
COSINE_SIMILARITY_THRESHOLD=0.70
TOP_K_RESULTS=4
